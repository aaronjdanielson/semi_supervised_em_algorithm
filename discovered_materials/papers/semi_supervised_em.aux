\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces  \textbf  {Persistence of the alignment signal across \(\lambda \).} \emph  {Left}: Pearson correlation between \(\mathcal  {A}_\mu (0)\) and AUROC gain as a function of \(\lambda \), pooled over all \(\delta \) levels. Correlation is stable (\(r\approx 0.47\text  {--}0.58\)) with no monotone decay, indicating that the directional signal in \(\mathcal  {A}_\mu (0)\) is not restricted to the local \(\lambda \approx 0\) regime in this design. \emph  {Right}: scatter of \(\mathcal  {A}_\mu (0)\) vs.\ gain at \(\lambda =0.05\) (local) and \(\lambda =2.0\) (far); regression lines are nearly parallel, confirming structural stability. }}{23}{figure.6}\protected@file@percent }
\newlabel{fig:local-lambda}{{6}{23}{\textbf {Persistence of the alignment signal across \(\lambda \).} \emph {Left}: Pearson correlation between \(\calA _\mu (0)\) and AUROC gain as a function of \(\lam \), pooled over all \(\delta \) levels. Correlation is stable (\(r\approx 0.47\text {--}0.58\)) with no monotone decay, indicating that the directional signal in \(\calA _\mu (0)\) is not restricted to the local \(\lam \approx 0\) regime in this design. \emph {Right}: scatter of \(\calA _\mu (0)\) vs.\ gain at \(\lam =0.05\) (local) and \(\lam =2.0\) (far); regression lines are nearly parallel, confirming structural stability}{figure.6}{}}
