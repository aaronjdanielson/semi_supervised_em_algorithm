\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces  \textbf  {Diagnostic as a decision rule.} \emph  {Left}: stacked bars show the composition of decisions (TP=green, FP=red, FN=orange, TN=blue) per \(\delta \) level. At low \(\delta \) the diagnostic correctly recommends use (TP dominant); at \(\delta =1.5\)--\(2.0\) a large FN block appears (diagnostic over-conservative); at high \(\delta \) TN recovers. \emph  {Right}: scatter of \(\Delta \mathrm  {AUROC}\) vs.\ \(\mathcal  {A}_\mu (0)\), colored by decision outcome. The quadrant shading marks the error regions (FP: top-left; FN: bottom-right). Most regret accrues in the FN region at intermediate \(\delta \). Overall accuracy 68\%, mean regret 0.006. }}{25}{figure.7}\protected@file@percent }
\newlabel{fig:decision}{{7}{25}{\textbf {Diagnostic as a decision rule.} \emph {Left}: stacked bars show the composition of decisions (TP=green, FP=red, FN=orange, TN=blue) per \(\delta \) level. At low \(\delta \) the diagnostic correctly recommends use (TP dominant); at \(\delta =1.5\)--\(2.0\) a large FN block appears (diagnostic over-conservative); at high \(\delta \) TN recovers. \emph {Right}: scatter of \(\Delta \mathrm {AUROC}\) vs.\ \(\calA _\mu (0)\), colored by decision outcome. The quadrant shading marks the error regions (FP: top-left; FN: bottom-right). Most regret accrues in the FN region at intermediate \(\delta \). Overall accuracy 68\%, mean regret 0.006}{figure.7}{}}
