\newlabel{tab:misspec}{{1}{21}{Misspecification experiment results (\(B=200\) replications each). \(\|\hat g_0\|\) is the per-observation score residual norm (scale-invariant w.r.t.\ \(N_u\)). Degradation \(= \text {R2} - \text {R3}\); positive values indicate R3 worse than R2}{table.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces  \textbf  {Score residual \(\|\hat  g_0\|\) (per-observation) as a misspecification indicator.} Each point is one simulation replication, colored by scenario. Degradation \(= \text  {AUROC}_{R2} - \text  {AUROC}_{R3}\); positive values indicate harm from unlabeled data. The Student-\(t\) scenario (red) concentrates in the upper-right quadrant, confirming that a large score residual norm predicts R3 degradation. }}{21}{figure.4}\protected@file@percent }
\newlabel{fig:misspec}{{4}{21}{\textbf {Score residual \(\|\hat g_0\|\) (per-observation) as a misspecification indicator.} Each point is one simulation replication, colored by scenario. Degradation \(= \text {AUROC}_{R2} - \text {AUROC}_{R3}\); positive values indicate harm from unlabeled data. The Student-\(t\) scenario (red) concentrates in the upper-right quadrant, confirming that a large score residual norm predicts R3 degradation}{figure.4}{}}
