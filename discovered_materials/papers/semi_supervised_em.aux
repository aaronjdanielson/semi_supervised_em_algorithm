\@writefile{lof}{\contentsline {figure}{\numberline {14}{\ignorespaces  \textbf  {Cross-dataset benchmark evaluation.} \emph  {Left}: alignment coefficient \(\mathcal  {A}_\mu (0)\) vs.\ realized AUROC gain per replication, colored by dataset. Points in the upper-right and lower-left quadrants are correct decisions. Near-Gaussian datasets (Banknote, Breast Cancer) cluster near the diagonal; high-\(\|\hat  g_0\|\) datasets (Sonar, Spambase) are scattered. \emph  {Center}: mean AUROC gain over R2 for R3, R4, R5. \emph  {Right}: per-dataset decision accuracy. The two-stage screen (filter on \(\|\hat  g_0\|\), then apply \(\mathcal  {A}_\mu (0)\)) correctly identifies which datasets benefit from semi-supervised learning. }}{33}{figure.14}\protected@file@percent }
\newlabel{fig:real-data-emp}{{14}{33}{\textbf {Cross-dataset benchmark evaluation.} \emph {Left}: alignment coefficient \(\mathcal {A}_\mu (0)\) vs.\ realized AUROC gain per replication, colored by dataset. Points in the upper-right and lower-left quadrants are correct decisions. Near-Gaussian datasets (Banknote, Breast Cancer) cluster near the diagonal; high-\(\|\hat g_0\|\) datasets (Sonar, Spambase) are scattered. \emph {Center}: mean AUROC gain over R2 for R3, R4, R5. \emph {Right}: per-dataset decision accuracy. The two-stage screen (filter on \(\|\hat g_0\|\), then apply \(\mathcal {A}_\mu (0)\)) correctly identifies which datasets benefit from semi-supervised learning}{figure.14}{}}
