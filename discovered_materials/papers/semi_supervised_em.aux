\newlabel{sec:sim-bv}{{5.3}{18}{The Bias--Variance Tradeoff as a Function of \texorpdfstring {$\lambda $}{lambda}}{subsection.5.3}{}}
\@writefile{toc}{\contentsline {paragraph}{Design.}{18}{section*.26}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Results.}{18}{section*.27}\protected@file@percent }
