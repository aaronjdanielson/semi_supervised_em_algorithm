\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces  \textbf  {AUROC gain(\(\lambda \)) and first-order tangent \(\lambda \cdot \mathcal  {A}_\mu (0)\)} (dashed lines) for three unlabeled-shift levels (\(B=60\) replications). At \(\delta =0\) (green), gain is positive and the tangent is accurate near \(\lambda =0\). At \(\delta =3\) (red), gain is negative and the sign is correctly predicted. At \(\delta =1.5\) (orange), the first-order term is small and positive, but the second-order term eventually dominates, producing a sign reversal at \(\lambda \approx 2\)---the regime in which \(\mathcal  {A}_\mu (0)\) most often fails. }}{22}{figure.5}\protected@file@percent }
\newlabel{fig:lam-traj}{{5}{22}{\textbf {AUROC gain(\(\lambda \)) and first-order tangent \(\lambda \cdot \calA _\mu (0)\)} (dashed lines) for three unlabeled-shift levels (\(B=60\) replications). At \(\delta =0\) (green), gain is positive and the tangent is accurate near \(\lam =0\). At \(\delta =3\) (red), gain is negative and the sign is correctly predicted. At \(\delta =1.5\) (orange), the first-order term is small and positive, but the second-order term eventually dominates, producing a sign reversal at \(\lam \approx 2\)---the regime in which \(\calA _\mu (0)\) most often fails}{figure.5}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {5.8}Diagnostic as an Operational Decision Rule}{22}{subsection.5.8}\protected@file@percent }
